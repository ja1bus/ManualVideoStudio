<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ManualVideoStudio</RootNamespace>
    <AssemblyName>ManualVideoStudio</AssemblyName>
    <Version>1.16.1</Version>
    <!-- 画面の文言は Resources/Strings.resx（日本語。既定の言語）。英語対応では同じキーの Strings.en.resx を足す（v1.13）。 -->
    <NeutralLanguage>ja</NeutralLanguage>
    <ApplicationIcon>Resources/icon.ico</ApplicationIcon>

    <!-- 配布は Framework-dependent。対象 PC の .NET 8 Desktop Runtime を使い、.NET は内包しない。FFmpeg も同梱しない。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Core / Imaging / Tests / IntegrationTests は別 csproj。既定の Compile 対象から除外する。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Imaging/**;Tests/**;IntegrationTests/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    Microsoft Store 用の MSIX（v1.16.1〜。仕様書 §39）。installer/msix/build-msix.ps1 が -p:ManualVideoStudioMsix=true で publish する。
    Store から入れた PC に .NET 8 Desktop Runtime があるとは限らないため、MSIX の中身だけは .NET を内包する（Self-contained・複数ファイル）。
    直接配布（フォルダー一式・Inno Setup）は従来どおり Framework-dependent で、この設定の影響を受けない。
  -->
  <PropertyGroup Condition="'$(ManualVideoStudioMsix)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- 取扱説明書（ヘルプ）。exe に埋め込み、［ヘルプ］で %LOCALAPPDATA% に書き出してブラウザーで開く。 -->
    <EmbeddedResource Include="Resources/Help/manual.html" LogicalName="ManualVideoStudio.Help.manual.html" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/ManualVideoStudio.Core.csproj" />
    <ProjectReference Include="Imaging/ManualVideoStudio.Imaging.csproj" />
  </ItemGroup>
</Project>
