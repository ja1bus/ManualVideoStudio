<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ManualVideoStudio</RootNamespace>
    <AssemblyName>ManualVideoStudio</AssemblyName>
    <Version>1.19.1</Version>
    <!-- 画面の文言は Resources/Strings.resx（日本語。既定の言語）。英語対応では同じキーの Strings.en.resx を足す（v1.13）。 -->
    <NeutralLanguage>ja</NeutralLanguage>
    <ApplicationIcon>Resources/icon.ico</ApplicationIcon>

    <!-- 配布は Framework-dependent。対象 PC の .NET 10 Desktop Runtime を使い、.NET は内包しない。FFmpeg も同梱しない。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Core / Imaging / Tests / IntegrationTests は別 csproj。既定の Compile 対象から除外する。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Imaging/**;Tests/**;IntegrationTests/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    Microsoft Store 用の MSIX（v1.16.1〜。仕様書 §39）。installer/msix/build-msix.ps1 が -p:ManualVideoStudioMsix=true で publish する。
    Store から入れた PC に .NET 10 Desktop Runtime があるとは限らないため、MSIX の中身だけは .NET を内包する（Self-contained・複数ファイル）。
    直接配布（フォルダー一式・Inno Setup）は従来どおり Framework-dependent で、この設定の影響を受けない。
  -->
  <PropertyGroup Condition="'$(ManualVideoStudioMsix)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>
  <!--
    ライセンス表記（v1.17.0）。MIT License の全文と第三者のソフトウェアの表記を、配布物（Inno Setup のインストール先・MSIX）の exe と同じフォルダーへ入れる。
    scripts では public-repo/ にある原本、公開リポジトリではルートにある同名のファイルを使う（公開リポジトリのビルドが public-repo/ に依存しないように）。
  -->
  <ItemGroup Condition="Exists('public-repo/LICENSE')">
    <None Update="public-repo/LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="public-repo/THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('public-repo/LICENSE') And Exists('LICENSE')">
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/ManualVideoStudio.Core.csproj" />
    <ProjectReference Include="Imaging/ManualVideoStudio.Imaging.csproj" />
  </ItemGroup>
</Project>
