<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 注釈の描画（Imaging、WPF）と主画面の ViewModel を試験するため net10.0-windows。FFmpeg は不要。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF では System.IO が暗黙の using に入らないため明示する -->
    <Using Include="System.IO" />
    <ProjectReference Include="../Core/ManualVideoStudio.Core.csproj" />
    <ProjectReference Include="../Imaging/ManualVideoStudio.Imaging.csproj" />
    <ProjectReference Include="../ManualVideoStudio.csproj" />
  </ItemGroup>
</Project>
