<Window x:Class="ManualVideoStudio.Views.SubtitleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="{Binding Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="文字" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="SubtitleText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" FontFamily="Meiryo" FontSize="14" AutomationProperties.Name="字幕の文字"
                     PreviewKeyDown="TextInput_PreviewKeyDown"/>
            <TextBlock Grid.Row="1" Text="開始" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="開始"/>
            <Button Grid.Row="1" Grid.Column="2" Content="現在位置" Command="{Binding StartFromCurrentCommand}"/>
            <TextBlock Grid.Row="2" Text="終了" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="終了"/>
            <Button Grid.Row="2" Grid.Column="2" Content="現在位置" Command="{Binding EndFromCurrentCommand}"/>
            <TextBlock Grid.Row="3" Text="表示位置" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <RadioButton Content="上" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Top}"/>
                <RadioButton Content="中央" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Middle}"/>
                <RadioButton Content="下" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Bottom}"/>
            </StackPanel>
            <TextBlock Grid.Row="4" Text="文字サイズ" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <ComboBox Width="80" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" AutomationProperties.Name="文字サイズ"/>
                <TextBlock Text="（動画の高さ 1080px のときの px）" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Subtle}" FontSize="11" Margin="0,6,0,0">
            <Run Text="時刻は編集後（カット適用後）の動画の時刻です。編集後の長さ"/>
            <Run Text="{Binding OutputDurationText, Mode=OneWay}"/><Run Text="。Enter で改行、Ctrl+Enter で決定。3 行・200 文字まで。"/>
        </TextBlock>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Style="{StaticResource AccentButton}" MinWidth="90" Command="{Binding OkCommand}" AutomationProperties.Name="OK"/>
            <Button Content="キャンセル" MinWidth="90" IsCancel="True" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
