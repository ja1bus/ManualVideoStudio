<Window x:Class="ManualVideoStudio.Views.TitleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManualVideoStudio"
        Style="{StaticResource AppWindow}" Title="{local:Str Title.Window}"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="Title.Window">
    <StackPanel Margin="16">
        <TextBlock Text="{local:Str Title.Intro}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBlock Text="{local:Str Title.Text}" Style="{StaticResource SectionTitle}"/>
        <TextBox x:Name="TitleText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="110" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" FontFamily="Meiryo" FontSize="14"
                 AutomationProperties.Name="{local:Str Title.Text}" AutomationProperties.AutomationId="Title.Text"/>
        <DockPanel Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="{local:Str Title.Clear}" ToolTip="{local:Str Title.Clear.Tip}" Command="{Binding ClearCommand}"
                    MinWidth="72" VerticalAlignment="Top" AutomationProperties.AutomationId="Title.Clear"/>
            <TextBlock Text="{local:Str Title.Hint}" Style="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Background="{StaticResource WarningBackgroundBrush}" CornerRadius="4" Padding="8,5" Margin="0,6,0,0"
                Visibility="{Binding LayoutWarning, Converter={StaticResource EmptyToCollapsed}}">
            <TextBlock Text="{Binding LayoutWarning}" TextWrapping="Wrap" AutomationProperties.AutomationId="Title.Warning"/>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{local:Str Title.Font}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="300" ItemsSource="{Binding FontChoices}" SelectedItem="{Binding SelectedFont}"
                          AutomationProperties.Name="{local:Str Title.Font}" AutomationProperties.AutomationId="Title.Font">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" Foreground="{StaticResource SubtleTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FontNote}" Style="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"
                       Visibility="{Binding FontNote, Converter={StaticResource EmptyToCollapsed}}" Margin="0,2,0,0"/>
            <TextBlock Grid.Row="2" Text="{local:Str Title.FontSize}" VerticalAlignment="Center" Margin="0,6,12,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox Width="80" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" ToolTip="{local:Str Title.FontSize.Tip}"
                          AutomationProperties.Name="{local:Str Title.FontSize}" AutomationProperties.AutomationId="Title.FontSize"/>
                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{local:Str Title.Seconds}" VerticalAlignment="Center"/>
            <ComboBox Width="56" Margin="12,0,4,0" ItemsSource="{Binding SecondsChoices}" SelectedItem="{Binding Seconds}"
                      AutomationProperties.Name="{local:Str Title.Seconds}" AutomationProperties.AutomationId="Title.Seconds"/>
            <TextBlock Text="{local:Str Title.SecondsUnit}" VerticalAlignment="Center"/>
        </StackPanel>
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding FadeIn}" Content="{local:Str Title.Fade}" ToolTip="{local:Str Title.Fade.Tip}"
                  AutomationProperties.AutomationId="Title.Fade"/>
        <TextBlock Text="{Binding DurationText}" Margin="0,8,0,0" AutomationProperties.AutomationId="Title.Duration"/>

        <TextBlock Text="{local:Str Title.Preview}" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
        <Border Background="Black" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
            <Image Source="{Binding PreviewImage}" Width="360" Stretch="Uniform" MaxHeight="220"
                   AutomationProperties.Name="{local:Str Title.Preview}" AutomationProperties.AutomationId="Title.Preview"/>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" AutomationProperties.AutomationId="Title.Error"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Style="{StaticResource AccentButton}" MinWidth="90" Command="{Binding OkCommand}" AutomationProperties.Name="OK"
                    AutomationProperties.AutomationId="Title.Ok"/>
            <Button Content="キャンセル" MinWidth="90" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="Title.Cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
