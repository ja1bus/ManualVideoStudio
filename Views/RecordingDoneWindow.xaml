<Window x:Class="ManualVideoStudio.Views.RecordingDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="録画の完了"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" Text="録画を保存しています…" Style="{StaticResource SectionTitle}"/>
        <ProgressBar x:Name="SavingBar" IsIndeterminate="True" Height="6" Margin="0,4,0,4"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="ファイル" Foreground="{StaticResource SubtleTextBrush}"/>
            <TextBox Grid.Column="1" x:Name="PathText" Text="作成中…" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0" Padding="0"/>
            <TextBlock Grid.Row="1" Text="長さ" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DurationText" Text="—" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Text="内容" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoText" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </Grid>
        <TextBlock Text="プロジェクト名" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
        <TextBox x:Name="NameText" TextChanged="NameText_TextChanged" AutomationProperties.Name="プロジェクト名" MaxLength="60"/>
        <TextBlock x:Name="FolderText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                   Text="保存している間にプロジェクト名を入力できます。録画ファイルは上のプロジェクトフォルダーへ移動します（名前が空なら日時だけのフォルダー）。［編集を開始］は録画した動画を開き、編集（カット・字幕など）を始めます。［保存して終了］は録画ファイルを残して録画画面を閉じます。"/>
        <TextBlock x:Name="WaitText" Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="ボタンは録画ファイルができてから押せます。Esc・Enter キーでは閉じません。"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="EditButton" Content="編集を開始" Style="{StaticResource AccentButton}" MinWidth="110" IsEnabled="False" Click="Edit_Click" AutomationProperties.Name="編集を開始"/>
            <Button x:Name="CloseButton" Content="保存して終了" MinWidth="110" IsEnabled="False" Click="Close_Click" AutomationProperties.Name="保存して終了"/>
        </StackPanel>
    </StackPanel>
</Window>
