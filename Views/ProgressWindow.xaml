<Window x:Class="ManualVideoStudio.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="{Binding Title}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"/>
        <TextBlock Text="キャンセルすると FFmpeg を終了し、途中まで作ったファイルは削除します。" Style="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0"/>
        <Button Content="キャンセル" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="100" Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsCanceling, Converter={StaticResource InverseBool}}"/>
    </StackPanel>
</Window>
