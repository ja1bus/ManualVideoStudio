<Window x:Class="ManualVideoStudio.Views.DeleteRequestVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="字幕依頼用動画の削除"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" AutomationProperties.AutomationId="Message"/>
        <TextBlock Text="対象のファイル" Style="{StaticResource SectionTitle}" Margin="0,10,0,2"/>
        <TextBox x:Name="PathBox" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="削除する字幕依頼用動画のフルパス"/>
        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="削除するのはこのファイルだけです（元動画・完成動画・プロジェクトは削除しません）。通常は［削除する］です。［削除しない］は、この動画を別の用途で使う場合だけ選んでください（このアプリでは再利用しません）。字幕の編集・保存・書き出しには影響せず、必要になれば再び作成できます。どちらを選んでも、字幕作成の画面は閉じます。"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <!-- 通常は削除する運用のため、既定（Enter）は［削除する］。ウィンドウを閉じるだけでは削除しない。 -->
            <Button x:Name="DeleteButton" Content="削除する" Style="{StaticResource AccentButton}" MinWidth="110" IsDefault="True" Click="Delete_Click"
                    AutomationProperties.Name="削除する"/>
            <Button x:Name="KeepButton" Content="削除しない" MinWidth="110" IsCancel="True" Click="Keep_Click" AutomationProperties.Name="削除しない"/>
        </StackPanel>
    </StackPanel>
</Window>
