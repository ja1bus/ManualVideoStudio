<Window x:Class="ManualVideoStudio.Views.TejunshoExportDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManualVideoStudio"
        Style="{StaticResource AppWindow}" Title="{local:Str Doc.DoneTitle}"
        Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding CountText}" FontWeight="SemiBold"/>
        <TextBlock Text="{local:Str Doc.DoneInfo}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="Doc.DoneInfo"/>
        <TextBlock Text="出力先" Style="{StaticResource SectionTitle}" Margin="0,10,0,2"/>
        <TextBox Text="{Binding Directory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="出力先"/>
        <TextBlock Text="{Binding MetaText}" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="手順書作成の依頼文" Style="{StaticResource SectionTitle}" Margin="0,12,0,2"/>
        <TextBox Text="{Binding RequestText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="依頼文"
                 MaxHeight="160" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{Binding RequestWarning}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding RequestWarning, Converter={StaticResource EmptyToCollapsed}}"/>
        <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="依頼文をコピーして Claude Code に貼り付けると、tejunsho-gui-docx スキルが Word の手順書を作ります（依頼文は設定→プロンプトで変えられます）。画像（.png / .jpg）が暗号化される PC では、先に images フォルダーの画像の暗号化を解除してください。"/>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="OtherPcHint"
                           Text="別の PC で手順書を作るときは、画像の暗号化を解いてから、このフォルダーを丸ごと、手順書を作る PC の同じ場所（ユーザー名の部分だけ違ってよい）へコピーしてください。zip にまとめる必要はありません（暗号化されたファイルを zip にまとめると、展開しても中のファイルは暗号化されたままです）。"/>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding CopyStatus}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="CopyStatus"
                   Visibility="{Binding CopyStatus, Converter={StaticResource EmptyToCollapsed}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="依頼文をコピー" Style="{StaticResource AccentButton}" MinWidth="130" IsDefault="True" Command="{Binding CopyRequestCommand}"/>
            <Button Content="フォルダーを開く" MinWidth="120" Command="{Binding OpenFolderCommand}"/>
            <Button Content="閉じる" MinWidth="90" IsCancel="True" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
