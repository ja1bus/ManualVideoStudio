<Window x:Class="ManualVideoStudio.Views.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ManualVideoStudio.ViewModels"
        xmlns:local="clr-namespace:ManualVideoStudio"
        xmlns:models="clr-namespace:ManualVideoStudio.Core.Models;assembly=ManualVideoStudio.Core"
        Style="{StaticResource AppWindow}" Title="画面を録画 - Manual Video Studio"
        Width="560" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Topmost="True" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,8,6"/>
        </Style>
        <!-- 1 つだけ選べるボタン（v1.16。サイズ・向き）。選択中は ✓ と太い枠・背景色で示す（色だけに頼らない）。✓ の幅は常に確保して並びを動かさない。 -->
        <Style x:Key="ChoiceButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Checked" Handler="ChoiceButton_Checked"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Check" Text="✓" Width="14" Visibility="Hidden" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBFA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Padding" Value="7,2"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,12" IsEnabled="{Binding IsIdle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 録画対象 -->
            <TextBlock Text="録画する対象" Style="{StaticResource Label}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="範囲を指定" AutomationProperties.Name="範囲を指定"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Region}"/>
                <RadioButton Content="ウィンドウ" AutomationProperties.Name="ウィンドウ"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Window}"/>
                <RadioButton Content="モニター全体" AutomationProperties.Name="モニター全体"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Monitor}"/>
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource InfoBackgroundBrush}" CornerRadius="4" Padding="8,6" Margin="0,2,0,6">
                <Grid>
                    <!-- 範囲 -->
                    <StackPanel Visibility="{Binding IsRegionMode, Converter={StaticResource BoolToVisibility}}">
                        <!-- サイズ・向き（v1.16）。規格サイズは縦横比を固定する。選択中は ✓・太い枠・背景色で示す。同じボタンを押し直すと規格サイズに戻す。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{local:Str Recorder.Size}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="RegionSize"
                                             Content="{Binding Preset720Label}" AutomationProperties.AutomationId="Recorder.Size720"
                                             AutomationProperties.Name="{Binding Preset720Label}" ToolTip="{local:Str Recorder.SizePreset.Tip}"
                                             IsChecked="{Binding IsPreset720, Mode=OneWay}"
                                             Command="{Binding SelectSizePresetCommand}" CommandParameter="{x:Static models:RegionSizePreset.Hd720}"/>
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="RegionSize"
                                             Content="{Binding Preset1080Label}" AutomationProperties.AutomationId="Recorder.Size1080"
                                             AutomationProperties.Name="{Binding Preset1080Label}" ToolTip="{local:Str Recorder.SizePreset.Tip}"
                                             IsChecked="{Binding IsPreset1080, Mode=OneWay}"
                                             Command="{Binding SelectSizePresetCommand}" CommandParameter="{x:Static models:RegionSizePreset.Hd1080}"/>
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="RegionSize"
                                             Content="{local:Str Recorder.SizeFree}" AutomationProperties.AutomationId="Recorder.SizeFree"
                                             AutomationProperties.Name="{local:Str Recorder.SizeFree}" ToolTip="{local:Str Recorder.SizeFree.Tip}"
                                             IsChecked="{Binding IsFreeSize, Mode=OneWay}"
                                             Command="{Binding SelectSizePresetCommand}" CommandParameter="{x:Static models:RegionSizePreset.Free}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{local:Str Recorder.Orientation}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanChangeOrientation}"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="{local:Str Recorder.Orientation.Tip}">
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="RegionOrientation" MinWidth="52"
                                             Content="{local:Str Recorder.Landscape}" AutomationProperties.AutomationId="Recorder.Landscape"
                                             AutomationProperties.Name="{local:Str Recorder.Landscape}"
                                             IsChecked="{Binding IsLandscape, Mode=OneWay}"
                                             Command="{Binding SelectOrientationCommand}" CommandParameter="{x:Static models:RegionOrientation.Landscape}"/>
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="RegionOrientation" MinWidth="52"
                                             Content="{local:Str Recorder.Portrait}" AutomationProperties.AutomationId="Recorder.Portrait"
                                             AutomationProperties.Name="{local:Str Recorder.Portrait}"
                                             IsChecked="{Binding IsPortrait, Mode=OneWay}"
                                             Command="{Binding SelectOrientationCommand}" CommandParameter="{x:Static models:RegionOrientation.Portrait}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="幅" VerticalAlignment="Center"/>
                            <TextBox Width="64" Text="{Binding RegionWidthText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="幅" AutomationProperties.AutomationId="Recorder.Width" KeyDown="SizeBox_KeyDown"/>
                            <TextBlock Text="×  高さ" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox Width="64" Text="{Binding RegionHeightText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="高さ" AutomationProperties.AutomationId="Recorder.Height" KeyDown="SizeBox_KeyDown"/>
                            <TextBlock Text="px" VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <Button Content="適用" AutomationProperties.AutomationId="Recorder.ApplySize" Padding="8,3" MinHeight="26" Command="{Binding ApplyRegionSizeCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0"
                                   Text="{local:Str Recorder.RegionHelp}"/>
                    </StackPanel>
                    <!-- ウィンドウ -->
                    <StackPanel Visibility="{Binding IsWindowMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="一覧を更新" Padding="8,3" MinHeight="26" Command="{Binding RefreshTargetsCommand}"/>
                            <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="録画するウィンドウ"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0"
                                   Text="録画開始時にウィンドウを前面に出し、その位置・大きさの範囲を録画します。録画中はウィンドウを移動しないでください（重なった別のウィンドウも写ります）。"/>
                    </StackPanel>
                    <!-- モニター -->
                    <StackPanel Visibility="{Binding IsMonitorMode, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="一覧を更新" Padding="8,3" MinHeight="26" Command="{Binding RefreshTargetsCommand}"/>
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="録画するモニター"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0"
                                   Text="選んだモニター全体を録画します。録画中のコントローラーは録画に写りません。"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="FPS" Style="{StaticResource Label}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="30 fps（標準）" AutomationProperties.Name="30 fps"
                             IsChecked="{Binding Fps, Converter={StaticResource IntEquals}, ConverterParameter=30}"/>
                <RadioButton Content="15 fps" AutomationProperties.Name="15 fps"
                             IsChecked="{Binding Fps, Converter={StaticResource IntEquals}, ConverterParameter=15}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="カーソル" Style="{StaticResource Label}"/>
            <CheckBox Grid.Row="3" Grid.Column="1" Content="マウスカーソルを録画する" IsChecked="{Binding DrawCursor}" AutomationProperties.Name="マウスカーソルを録画する"/>

            <TextBlock Grid.Row="4" Text="音声" Style="{StaticResource Label}" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="4" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="なし" AutomationProperties.Name="音声なし"
                                 IsChecked="{Binding MicrophoneEnabled, Converter={StaticResource InverseBool}}"/>
                    <RadioButton Content="マイク" AutomationProperties.Name="マイク"
                                 IsChecked="{Binding MicrophoneEnabled}"/>
                    <ComboBox Width="300" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label"
                              IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="マイクの選択"/>
                </StackPanel>
                <TextBlock Text="{Binding MicrophoneMessage}" Style="{StaticResource Subtle}" FontSize="11"
                           Visibility="{Binding MicrophoneMessage, Converter={StaticResource EmptyToCollapsed}}"/>
                <TextBlock Style="{StaticResource Subtle}" FontSize="11" Text="通常は「なし」で録画します。説明の音声を一緒に録る場合だけ「マイク」を選んでください（毎回「なし」から始まります）。"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Text="開始" Style="{StaticResource Label}"/>
            <CheckBox Grid.Row="5" Grid.Column="1" Content="録画開始前に 3 秒カウントダウンする" IsChecked="{Binding Countdown}" AutomationProperties.Name="カウントダウン"/>

            <TextBlock Grid.Row="6" Text="保存先" Style="{StaticResource Label}"/>
            <DockPanel Grid.Row="6" Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="参照..." Padding="8,3" MinHeight="26" Command="{Binding BrowseOutputCommand}"/>
                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="保存先"
                         ToolTip="録画が終わるとこの中に「日時_プロジェクト名」のフォルダーを作り、録画ファイルを入れます"/>
            </DockPanel>
        </Grid>

        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}"/>
        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" MinWidth="90" Command="{Binding CloseCommand}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Background="#C42B1C" BorderBrush="#C42B1C" Padding="18,7" FontSize="14"
                    Command="{Binding StartCommand}" AutomationProperties.Name="録画開始">
                <TextBlock Text="● 録画開始"/>
            </Button>
            <TextBlock Style="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center" Margin="10,0"
                       Text="Ctrl+Shift+F9: 録画開始 / 停止&#10;Ctrl+Shift+F8: 一時停止 / 再開"/>
        </DockPanel>
    </StackPanel>
</Window>
