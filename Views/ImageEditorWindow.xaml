<Window x:Class="ManualVideoStudio.Views.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ManualVideoStudio.Controls"
        xmlns:vm="clr-namespace:ManualVideoStudio.ViewModels"
        xmlns:core="clr-namespace:ManualVideoStudio.Core.Models;assembly=ManualVideoStudio.Core"
        xmlns:ann="clr-namespace:ManualVideoStudio.Core.Annotations;assembly=ManualVideoStudio.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Style="{StaticResource AppWindow}" Title="{Binding WindowTitle}"
        Width="1280" Height="860" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>
        <sys:Boolean x:Key="False">False</sys:Boolean>
        <!-- 選択中のツール・色・線幅・文字の太さを強調するボタン（Tag=True で選択表示） -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="Bd" Property="Background" Value="#DDEBFA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,4,0"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Rectangle">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel>
                <TextBlock Text="ツール" Style="{StaticResource GroupLabel}" Margin="0,0,4,0"/>
                <Button Style="{StaticResource ToolButton}" Content="選択" ToolTip="注釈の選択・移動・変形 [V]"
                        Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Select}"
                        Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Select}"/>
                <Button Style="{StaticResource ToolButton}" Content="四角" ToolTip="枠線の四角形 [R]"
                        Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Rectangle}"
                        Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rectangle}"/>
                <Button Style="{StaticResource ToolButton}" Content="矢印" ToolTip="矢印付きの線（終点に矢じり） [A]"
                        Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Arrow}"
                        Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Arrow}"/>
                <Button Style="{StaticResource ToolButton}" Content="直線" ToolTip="矢じりの無い線 [L]"
                        Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Line}"
                        Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Line}"/>
                <Button Style="{StaticResource ToolButton}" Content="文字" ToolTip="クリックした位置に文字 [T]"
                        Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Text}"
                        Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Text}"/>
                <Button Style="{StaticResource ToolButton}" Content="モザイク" ToolTip="機微情報を隠す（保存画像に焼き込み） [M]"
                        Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Mosaic}"
                        Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Mosaic}"/>

                <TextBlock Text="色" Style="{StaticResource GroupLabel}"/>
                <Button Style="{StaticResource ToolButton}" ToolTip="黒（選択中の注釈にも適用）" AutomationProperties.Name="黒"
                        Tag="{Binding Color, Converter={StaticResource EnumEquals}, ConverterParameter=Black}"
                        Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:AnnotationColor.Black}">
                    <StackPanel Orientation="Horizontal"><Rectangle Style="{StaticResource Swatch}" Fill="#000000"/><TextBlock Text="黒"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="赤（選択中の注釈にも適用）" AutomationProperties.Name="赤"
                        Tag="{Binding Color, Converter={StaticResource EnumEquals}, ConverterParameter=Red}"
                        Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:AnnotationColor.Red}">
                    <StackPanel Orientation="Horizontal"><Rectangle Style="{StaticResource Swatch}" Fill="#E60012"/><TextBlock Text="赤"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="青（選択中の注釈にも適用）" AutomationProperties.Name="青"
                        Tag="{Binding Color, Converter={StaticResource EnumEquals}, ConverterParameter=Blue}"
                        Command="{Binding SetColorCommand}" CommandParameter="{x:Static core:AnnotationColor.Blue}">
                    <StackPanel Orientation="Horizontal"><Rectangle Style="{StaticResource Swatch}" Fill="#0050D0"/><TextBlock Text="青"/></StackPanel>
                </Button>

                <TextBlock Text="線幅" Style="{StaticResource GroupLabel}"/>
                <Button Style="{StaticResource ToolButton}" Content="細" ToolTip="四角形・矢印・直線の線幅（選択中の注釈にも適用）"
                        Tag="{Binding StrokeLevel, Converter={StaticResource EnumEquals}, ConverterParameter=Thin}"
                        Command="{Binding SetStrokeCommand}" CommandParameter="{x:Static ann:StrokeWidthLevel.Thin}"/>
                <Button Style="{StaticResource ToolButton}" Content="中" ToolTip="四角形・矢印・直線の線幅（選択中の注釈にも適用）"
                        Tag="{Binding StrokeLevel, Converter={StaticResource EnumEquals}, ConverterParameter=Medium}"
                        Command="{Binding SetStrokeCommand}" CommandParameter="{x:Static ann:StrokeWidthLevel.Medium}"/>
                <Button Style="{StaticResource ToolButton}" Content="太" ToolTip="四角形・矢印・直線の線幅（選択中の注釈にも適用）"
                        Tag="{Binding StrokeLevel, Converter={StaticResource EnumEquals}, ConverterParameter=Thick}"
                        Command="{Binding SetStrokeCommand}" CommandParameter="{x:Static ann:StrokeWidthLevel.Thick}"/>

                <TextBlock Text="文字" Style="{StaticResource GroupLabel}"/>
                <Button Style="{StaticResource ToolButton}" Content="普通" ToolTip="普通の太さの文字（選択中の文字にも適用）"
                        Tag="{Binding IsBold, Converter={StaticResource InverseBool}}"
                        Command="{Binding SetBoldCommand}" CommandParameter="{StaticResource False}"/>
                <Button Style="{StaticResource ToolButton}" Content="太字" FontWeight="Bold" ToolTip="太字（選択中の文字にも適用）"
                        Tag="{Binding IsBold}"
                        Command="{Binding SetBoldCommand}" CommandParameter="{StaticResource True}"/>
                <TextBlock Text="サイズ" Style="{StaticResource GroupLabel}" Margin="8,0,4,0"/>
                <ComboBox x:Name="FontSizeBox" Width="70" VerticalAlignment="Center" ToolTip="文字サイズ（選択中の文字にも適用）"
                          AutomationProperties.Name="文字サイズ"
                          ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}"
                          DropDownClosed="FontSizeBox_DropDownClosed"/>
            </WrapPanel>
        </Border>

        <!-- 編集操作 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="表示" Style="{StaticResource GroupLabel}"/>
                    <Button Style="{StaticResource ToolButton}" Content="全体" ToolTip="ウィンドウに合わせる"
                            Tag="{Binding IsFit}" Command="{Binding ZoomFitCommand}"/>
                    <Button Content="100%" Padding="8,4" ToolTip="原寸（画像 1px = 画面 1px）" Command="{Binding ZoomActualCommand}"/>
                    <Button Content="－" Padding="10,4" ToolTip="縮小（Ctrl+ホイール）" Command="{Binding ZoomOutCommand}"/>
                    <Button Content="＋" Padding="10,4" ToolTip="拡大（Ctrl+ホイール）" Command="{Binding ZoomInCommand}"/>
                    <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="44" Margin="6,0,0,0" FontFamily="Consolas"/>
                </StackPanel>
                <WrapPanel>
                    <Button Content="↶ 元に戻す" ToolTip="{Binding UndoText}" Command="{Binding UndoCommand}"/>
                    <Button Content="↷ やり直し" ToolTip="{Binding RedoText}" Command="{Binding RedoCommand}"/>
                    <Button Content="文字を編集" ToolTip="選択中の文字を編集（ダブルクリックでも可）" Command="{Binding EditTextCommand}"
                            IsEnabled="{Binding SelectedIsText}"/>
                    <Button Content="削除" ToolTip="選択中の注釈を削除 [Delete]" Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding HasSelection}"/>
                    <Button Content="全削除" ToolTip="この画像の注釈をすべて削除" Command="{Binding ClearAllCommand}"
                            IsEnabled="{Binding HasAnnotations}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 動画の図形（v1.6）: 表示する時間 -->
        <Border DockPanel.Dock="Top" Padding="10,5" Background="#F7E8FA"
                Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="表示する時間（編集後の動画）" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="開始" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="110" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                             AutomationProperties.Name="図形の表示開始" ToolTip="表示を始める時刻（HH:MM:SS.mmm）"/>
                    <TextBlock Text="終了" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox Width="110" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                             AutomationProperties.Name="図形の表示終了" ToolTip="表示を終える時刻（HH:MM:SS.mmm。この時刻は含まない）"/>
                    <Button Content="最後まで" Command="{Binding SetEndToLastCommand}" AutomationProperties.Name="最後まで"
                            ToolTip="終了を編集後の動画の最後にします（モザイクで最後まで隠す場合など）"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Subtle}">
                        <Run Text="編集後の長さ"/><Run Text="{Binding OutputDurationText, Mode=OneWay}"/>
                    </TextBlock>
                </WrapPanel>
                <TextBlock Text="{Binding TargetText}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TimeError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding TimeError, Converter={StaticResource EmptyToCollapsed}}"/>
            </StackPanel>
        </Border>

        <!-- 保存先 -->
        <Border DockPanel.Dock="Top" Padding="10,4" Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutputMissing}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TargetText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}"/>
        </Border>

        <!-- 下部: 状態と保存 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding SaveButtonText}" Style="{StaticResource AccentButton}" MinWidth="130" ToolTip="{Binding SaveButtonToolTip}"
                            Command="{Binding SaveCommand}" AutomationProperties.Name="{Binding SaveButtonText}"/>
                    <Button Content="{Binding CloseButtonText}" MinWidth="90" Command="{Binding CloseCommand}" AutomationProperties.Name="{Binding CloseButtonText}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="11">
                        <Run Text="{Binding CountText, Mode=OneWay}"/><Run Text="　"/><Run Text="{Binding SelectionText, Mode=OneWay}"/><Run Text="　画像 "/><Run Text="{Binding ImageSizeText, Mode=OneWay}"/><Run Text="　｜ V 選択 / R 四角 / A 矢印 / L 直線 / T 文字 / M モザイク / Delete 削除 / 矢印キー 1px 移動（Shift で 10px）/ Esc 取り消し・選択解除"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#3A3A3A" Focusable="False">
            <ctl:AnnotationCanvas x:Name="Canvas" Editor="{Binding}"/>
        </ScrollViewer>
    </DockPanel>
</Window>
