<Window x:Class="ManualVideoStudio.Views.RecordingStopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="録画の確認"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock Text="録画を停止しました。この録画を保存しますか？" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="長さ" Foreground="{StaticResource SubtleTextBrush}"/>
            <TextBlock Grid.Column="1" x:Name="DurationText" Text="—"/>
            <TextBlock Grid.Row="1" Text="内容" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoText" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </Grid>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="［保存する］録画ファイルを保存し、プロジェクト名の入力に進みます。"/>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap"
                   Text="［破棄して録り直す］この録画を捨て、録画画面に戻って録り直します。"/>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap"
                   Text="［破棄して閉じる］この録画を捨てて録画画面を閉じます。"/>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="破棄した録画ファイルはごみ箱へ移動します。"/>
        <TextBlock x:Name="WaitText" Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="ボタンは少し待ってから押せます。Esc・Enter キーでは閉じません。"/>
        <Grid Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RetakeButton" Content="破棄して録り直す" MinWidth="130" IsEnabled="False" Click="Retake_Click" AutomationProperties.Name="破棄して録り直す"/>
                <Button x:Name="DiscardButton" Content="破棄して閉じる" MinWidth="120" IsEnabled="False" Click="Discard_Click" AutomationProperties.Name="破棄して閉じる"/>
            </StackPanel>
            <Button x:Name="SaveButton" Content="保存する" Style="{StaticResource AccentButton}" MinWidth="110" HorizontalAlignment="Right"
                    IsEnabled="False" Click="Save_Click" AutomationProperties.Name="保存する"/>
        </Grid>
    </StackPanel>
</Window>
